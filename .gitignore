*.apk
*.aab
*.ap_
*.dex

# Signing
*.jks
*.keystore
keystore.properties

# Logs
*.log

# OS
.DS_Store
Thumbs.db

# Claude Code session artifacts
.claude/
.codex/
.agents/

# Local dev-server runtime state (justfile dev-up/dev-down)
.dev/

# Machine-specific dev-environment config (see dev.toml.example)
dev.toml
